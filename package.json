{
  "name": "wholesalehub-phase1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:test:init": "npm run test:init --workspace @wholesalehub/database",
    "dev": "npm run build && node dist/cli.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "phase1": "npm run build && node dist/cli.js phase1",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "ky": "^1.14.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/node": "^24.10.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
