{
  "name": "wholesalehub-phase1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:test:init": "npm run test:init --workspace @wholesalehub/database",
    "dev": "npm run build && node dist/cli.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "mapping:dailyfood:reset": "npm run build && node dist/normalization/reset-dailyfood-mappings-cli.js",
    "mapping:woocommerce:approve": "npm run build && node dist/woocommerce/mapping-cli.js approve",
    "mapping:woocommerce:disable": "npm run build && node dist/woocommerce/mapping-cli.js disable",
    "mapping:woocommerce:list": "npm run build && node dist/woocommerce/mapping-cli.js list",
    "mapping:woocommerce:seed-pending": "npm run build && node dist/woocommerce/mapping-cli.js seed-pending",
    "phase1": "npm run build && node dist/cli.js phase1",
    "report:compare": "npm run build && node dist/reports/report-cli.js compare",
    "atomic-sku:apply": "npm run build && node dist/reports/atomic-sku-apply-cli.js",
    "daily:stable-collect": "npm run build && node dist/reports/daily-stable-collect-cli.js",
    "daily:safe-draft-plan": "npm run build && node dist/reports/safe-daily-draft-plan-cli.js",
    "woo:link-variation-offers": "npm run build && node dist/reports/woo-variation-offer-link-cli.js",
    "orders:export-supplier-snapshot-csv": "npm run build && node dist/reports/supplier-order-snapshot-csv-cli.js",
    "report:mapping": "npm run build && node dist/reports/report-cli.js mapping",
    "report:raw": "npm run build && node dist/reports/report-cli.js raw",
    "report:woocommerce-dry-run": "npm run build && node dist/reports/report-cli.js woocommerce-dry-run",
    "test": "npm run build && vitest run",
    "test:gemini-live": "npm run build && node dist/normalization/gemini-live-test.js",
    "walldob2b:import": "npm run build && node dist/adapters/walldob2b/walldob2b-import-cli.js",
    "walldob2b:sample": "npm run build && node dist/adapters/walldob2b/walldob2b-sample-cli.js",
    "walldob2b:stock-sync": "npm run build && node dist/reports/walldob2b-stock-sync-cli.js",
    "typecheck": "tsc --noEmit",
    "woocommerce:search": "npm run build && node dist/woocommerce/search-cli.js",
    "report:overlap-audit": "npm run build && node dist/reports/overlap-audit-cli.js",
    "report:overlap-review": "npm run build && node dist/reports/overlap-review-cli.js",
    "report:sell-plan": "npm run build && node dist/reports/sell-plan-cli.js",
    "report:woocommerce-match": "npm run build && node dist/reports/woocommerce-match-cli.js",
    "mapping:woocommerce:approve-exact-safe": "npm run build && node dist/reports/approved-mapping-cli.js",
    "report:price-change-review": "npm run build && node dist/reports/price-change-review-cli.js",
    "woocommerce:live-update": "npm run build && node dist/woocommerce/live-update-cli.js",
    "report:update-candidate-audit": "npm run build && node dist/reports/update-candidate-audit-cli.js",
    "report:product-group-plan": "npm run build && node dist/reports/product-group-plan-cli.js",
    "woocommerce:sync-plan": "npm run build && node dist/reports/woocommerce-product-sync-plan-cli.js",
    "report:parsing-rule-questions": "npm run build && node dist/reports/parsing-rule-questions-cli.js",
    "parsing-rules:apply": "npm run build && node dist/reports/parsing-rule-apply-cli.js",
    "parsing-rules:auto-answer": "npm run build && node dist/reports/parsing-rule-auto-answer-cli.js",
    "report:human-product-status": "npm run build && node dist/reports/human-product-status-cli.js",
    "report:product-filter-taxonomy": "npm run build && node dist/reports/product-filter-taxonomy-cli.js",
    "report:draft-products-review": "npm run build && node dist/reports/draft-products-review-cli.js",
    "draft-products:publish-plan": "npm run build && node dist/reports/draft-products-publish-cli.js",
    "report:draft-vs-existing-merge": "npm run build && node dist/reports/draft-vs-existing-merge-cli.js",
    "report:mvp-sync-plan": "npm run build && node dist/reports/mvp-sync-plan-cli.js",
    "mvp-sync:execute": "npm run build && node dist/reports/mvp-sync-execute-cli.js",
    "mvp-add-create:execute": "npm run build && node dist/reports/mvp-add-create-cli.js",
    "mvp-customer-qa": "npm run build && node dist/reports/mvp-customer-qa-cli.js",
    "mvp:plan": "npm run report:mvp-sync-plan --",
    "mvp:sync-existing": "npm run mvp-sync:execute --",
    "mvp:add-create": "npm run mvp-add-create:execute --",
    "mvp:qa": "npm run mvp-customer-qa",
    "mvp:handoff": "npm run build && node dist/reports/mvp-handoff-cli.js",
    "mvp:export-review": "npm run build && node dist/reports/mvp-export-review-cli.js",
    "mvp:n8n-run": "bash scripts/n8n-mvp-sync.sh",
    "orders:supplier-report": "npm run build && node dist/reports/order-supplier-fulfillment-cli.js",
    "orders:export-supplier-excels": "npm run build && node dist/reports/order-supplier-excel-export-cli.js",
    "woocommerce:cleanup-duplicate-drafts": "npm run build && node dist/reports/draft-private-duplicate-cleanup-cli.js",
    "mvp:delete-unsold": "npm run build && node dist/reports/mvp-delete-unsold-cli.js",
    "rebuild:draft-catalog": "npm run build && node dist/reports/rebuild-draft-catalog-cli.js",
    "rebuild:public-v2": "npm run build && node dist/reports/rebuild-public-catalog-v2-cli.js",
    "woocommerce:repair-images": "npm run build && node dist/reports/repair-public-product-images-cli.js",
    "woocommerce:classify-public-categories": "npm run build && node dist/reports/classify-public-products-cli.js",
    "woocommerce:consolidate-public-groups": "npm run build && node dist/reports/consolidate-public-product-groups-cli.js",
    "woocommerce:audit-public-prices": "npm run build && node dist/reports/audit-public-variation-prices-cli.js",
    "mvp:hide-unsold-public": "npm run build && node dist/reports/hide-unsold-public-variations-cli.js",
    "dailyfood:direct-crawl": "npm run build && node dist/reports/dailyfood-direct-site-crawl-cli.js",
    "supplier:detail-image-crawl": "npm run build && node dist/reports/supplier-detail-image-crawl-cli.js",
    "groupbuy:sync-fafane-descriptions": "npm run build && node dist/reports/fafane-description-sync-cli.js",
    "mvp:delete-source-absent": "npm run build && node dist/reports/mvp-source-absence-delete-cli.js"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "exceljs": "^4.4.0",
    "ky": "^1.14.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/node": "^24.10.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
