[Unit]
Description=WholesaleHub Codex AI merchandising queue worker
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/tnfwod/projects/wholesalehub
ExecStart=/usr/bin/env bash /home/tnfwod/projects/wholesalehub/scripts/ai-merchandising/run-queue.sh
TimeoutStartSec=2700
Nice=10

# This is a per-user service. Codex ChatGPT authentication/session state lives
# under the service user's home, so ProtectHome/ProtectSystem=strict would break
# the authenticated CLI. Keep system paths read-only without globally weakening
# the host sandbox/user-namespace policy.
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target
