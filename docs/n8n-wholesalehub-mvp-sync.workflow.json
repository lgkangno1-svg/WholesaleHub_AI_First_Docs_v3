      {
        "parameters": {
          "jsCode": "const parts = new Intl.DateTimeFormat(\"en-CA\", {\n  timeZone: \"Asia/Seoul\",\n  year: \"numeric\",\n  month: \"2-digit\",\n  day: \"2-digit\",\n  hour: \"2-digit\",\n  hourCycle: \"h23\",\n}).formatToParts(new Date()).reduce((acc, part) => {\n  if (part.type !== \"literal\") acc[part.type] = part.value;\n  return acc;\n}, {});\nif (parts.hour !== \"09\") return [];\nreturn [{\n  json: {\n    subjectDate: `${parts.year}-${parts.month}-${parts.day}`,\n    recipient: \"tnfwod@naver.com\",\n    emailWindow: \"09:00 Asia/Seoul\",\n  },\n}];"
        },
        "id": "email-window-gate",
        "name": "09 KST Email Gate",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [-240, 20]
      },
      {
        "parameters": {
          "command": "cd /home/tnfwod/projects/wholesalehub && node -e 'const fs=require(\"fs\"); const files={walldo:\"reports/orders/walldo-order.xlsx\",dailyfood:\"reports/orders/dailyfood-order.xlsx\"}; const out={}; for (const [k,p] of Object.entries(files)) out[k]=fs.readFileSync(p).toString(\"base64\"); console.log(JSON.stringify(out));'",
          "authentication": "privateKey",
          "resource": "command",
          "operation": "execute"
        },
        "id": "ssh-read-order-excels",
        "name": "Read Order Excel Attachments",
        "type": "n8n-nodes-base.ssh",
        "typeVersion": 1,
        "position": [20, 20],
        "credentials": {
          "sshPrivateKey": {
            "id": "QYVqJGt04jJ45Kc3",
            "name": "minipc-ssh"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const stdout = $json.stdout || \"\";\nconst jsonLine = stdout.trim().split(\"\\n\").map((line) => line.replace(/\\r$/u, \"\")).reverse().find((line) => line.trim().startsWith(\"{\"));\nif (!jsonLine) throw new Error(\"missing order excel attachment payload\");\nconst payload = JSON.parse(jsonLine);\nconst dateParts = new Intl.DateTimeFormat(\"en-CA\", {\n  timeZone: \"Asia/Seoul\",\n  year: \"numeric\",\n  month: \"2-digit\",\n  day: \"2-digit\",\n}).formatToParts(new Date()).reduce((acc, part) => {\n  if (part.type !== \"literal\") acc[part.type] = part.value;\n  return acc;\n}, {});\nconst subjectDate = `${dateParts.year}-${dateParts.month}-${dateParts.day}`;\nconst mimeType = \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\";\nreturn [{\n  json: {\n    recipient: \"tnfwod@naver.com\",\n    subject: `[도매허브] 오늘 발주 엑셀 ${subjectDate}`,\n    attachmentCount: 2,\n  },\n  binary: {\n    walldo: { data: payload.walldo, fileName: \"walldo-order.xlsx\", mimeType },\n    dailyfood: { data: payload.dailyfood, fileName: \"dailyfood-order.xlsx\", mimeType },\n  },\n}];"
        },
        "id": "build-order-email",
        "name": "Build Order Excel Email",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [280, 20]
      },
